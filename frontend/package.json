{
    "name": "ja-platform-dashboard",
    "private": true,
    "version": "1.0.0",
    "author": "Jejakawan <jejakawan007@github.com>",
    "type": "module",
    "engines": {
        "node": ">=20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "test:e2e:list": "playwright test --list",
        "test:e2e:smoke": "playwright test tests/e2e/auth-probe-notfound.spec.ts",
        "test:e2e:public": "PLAYWRIGHT_WEB_SERVER=1 playwright test tests/e2e/theme-contact-public.spec.ts",
        "test:e2e:auth": "playwright test tests/e2e/auth-probe-notfound.spec.ts tests/e2e/login.spec.ts",
        "quality:frontend": "eslint src tests --max-warnings=0 && vue-tsc -b && npm run test:e2e:list",
        "clean:ts": "rm -rf node_modules/.tmp",
        "clean:vite": "rm -rf node_modules/.vite",
        "clean:dist": "rm -rf dist",
        "clean:cache": "npm run clean:ts && npm run clean:vite",
        "rebuild": "npm run clean:cache && npm run clean:dist && npm run build"
    },
