{
    "name": "Janari Education",
    "slug": "janari-education",
    "version": "V.2.0",
    "type": "frontend",
    "description": "Janari Theme - A modern, elegant theme for JA-Platform",
    "author": "Jejakawan",
    "supports": {
        "janari_canvas": true
    },
    "settings_schema": {
        "site_title": {
            "label": "Site Title",
            "type": "text",
            "default": "JA-Platform",
            "category": "General"
        },
        "school_level": {
            "label": "School Level",
            "type": "select",
            "options": [
                {
                    "label": "SD (Sekolah Dasar)",
                    "value": "sd"
                },
                {
                    "label": "SMP (Sekolah Menengah Pertama)",
                    "value": "smp"
                },
                {
                    "label": "SMA (Sekolah Menengah Atas)",
                    "value": "sma"
                },
                {
                    "label": "SMK (Sekolah Menengah Kejuruan)",
                    "value": "smk"
                },
                {
                    "label": "Gabungan / Yayasan / Multi-Level",
                    "value": "gabungan"
                }
            ],
            "default": "smk",
            "category": "Education Info"
        },
        "school_status": {
            "label": "School Type / Status",
            "type": "select",
            "options": [
                {
                    "label": "Negeri (Public)",
                    "value": "negeri"
                },
                {
                    "label": "Swasta (Private)",
                    "value": "swasta"
                }
            ],
            "default": "negeri",
            "category": "Education Info"
        },
        "active_levels": {
            "label": "Active Levels (For Gabungan)",
            "type": "checkbox_list",
            "options": [
                {
                    "label": "SD",
                    "value": "sd"
                },
                {
                    "label": "SMP",
                    "value": "smp"
                },
                {
                    "label": "SMA",
                    "value": "sma"
                },
                {
                    "label": "SMK",
                    "value": "smk"
                }
            ],
            "default": [
                "smk"
            ],
            "category": "Education Info",
            "description": "Specify which levels are managed if School Level is 'Gabungan'"
        },
        "theme_style": {
            "label": "Theme Visual Style",
            "type": "select",
            "options": [
                {
                    "label": "Clean & Minimalist",
                    "value": "clean"
                },
                {
                    "label": "Flat Modern",
                    "value": "flat"
                },
                {
                    "label": "Soft & Pastel",
                    "value": "soft"
                },
                {
                    "label": "Glassmorphism (Premium)",
                    "value": "glass"
                }
            ],
            "default": "clean",
            "category": "Appearance"
        },
        "brand_logo": {
            "label": "Logo",
            "type": "media",
            "category": "General"
        },
        "brand_favicon": {
            "label": "Favicon",
            "type": "media",
            "category": "General"
        },
        "site_tagline": {
            "label": "Site Tagline",
            "type": "text",
            "default": "Modern & Elegant CMS",
            "category": "General"
        },
        "site_description": {
            "label": "Site Description",
            "type": "textarea",
            "default": "Modern Content Management System built with Laravel and Vue.js",
            "category": "General"
        },
        "branding_display": {
            "label": "Branding Display",
            "type": "select",
            "options": [
                {
                    "label": "Logo only",
                    "value": "logo_only"
