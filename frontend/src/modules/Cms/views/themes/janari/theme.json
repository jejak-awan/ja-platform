        "color_intensity": {
            "label": "Palette Intensity",
            "type": "select",
            "default": "balanced",
            "category": "Colors",
            "description": "Controls how strong the global color tint appears across cards, borders, accents, and surfaces.",
            "options": [
                {
                    "label": "Soft",
                    "value": "soft"
                },
                {
                    "label": "Balanced",
                    "value": "balanced"
                },
                {
                    "label": "Vibrant",
                    "value": "vibrant"
                }
            ]
        },
        "monochrome_variant": {
            "label": "Monochrome Base Variant",
            "type": "select",
            "default": "clean",
            "category": "Colors",
            "description": "Control black/white base depth for light/dark mode while accent color stays separate.",
            "options": [
                {
                    "label": "Clean",
                    "value": "clean"
                },
                {
                    "label": "Soft Contrast",
                    "value": "soft"
                },
                {
                    "label": "Matte",
                    "value": "matte"
                },
                {
                    "label": "High Contrast",
                    "value": "high_contrast"
                }
            ]
