        "monochrome_texture": {
            "label": "Surface Texture",
            "type": "select",
            "default": "clean",
            "category": "Colors",
            "description": "Add subtle texture pattern over page background. Works with all presets.",
            "options": [
                {
                    "label": "Clean (No Texture)",
                    "value": "clean"
                },
                {
                    "label": "Dot Matrix",
                    "value": "dots"
                },
                {
                    "label": "Fine Grain",
                    "value": "grain"
                }
            ]
        },
        "monochrome_texture_strength": {
            "label": "Texture Strength",
            "type": "range",
            "min": 0,
            "max": 35,
            "step": 1,
            "default": 8,
            "category": "Colors",
            "description": "Lower for subtle premium effect, higher for visible texture."
        },
        "color_primary": {
            "label": "Primary Color",
            "type": "color",
            "default": "#1e40af",
            "category": "Colors"
        },
        "color_background": {
            "label": "Background Color (stored)",
            "type": "color",
            "default": "#f9fafb",
            "category": "Colors",
            "hidden": true,
            "description": "Hidden; light/dark backgrounds use bg_light_color / bg_dark_color in the customizer."
        },
        "bg_light_color": {
            "label": "Light Mode Background",
            "type": "select",
            "default": "white",
            "category": "Colors",
            "description": "Base background color for light mode.",
            "options": [
                { "label": "⬜ White (Default)", "value": "white" },
                { "label": "🟡 Cream / Ivory", "value": "cream" },
                { "label": "🔵 Cool Gray", "value": "cool_gray" },
                { "label": "🟠 Warm Gray", "value": "warm_gray" },
                { "label": "🟢 Mint", "value": "mint" },
                { "label": "🟣 Lavender", "value": "lavender" },
                { "label": "🔴 Blush / Rose", "value": "blush" },
                { "label": "🔵 Sky", "value": "sky" },
                { "label": "🟡 Sand", "value": "sand" }
            ]
        },
        "bg_light_variant": {
            "label": "Light Background Variant",
            "type": "select",
            "default": "clean",
            "category": "Colors",
            "description": "Fine-tune the light background tone.",
            "options": [
                { "label": "Clean (Pure)", "value": "clean" },
                { "label": "Soft", "value": "soft" },
                { "label": "Matte", "value": "matte" },
                { "label": "Warm", "value": "warm" }
            ]
        },
        "bg_dark_color": {
            "label": "Dark Mode Background",
            "type": "select",
            "default": "black",
            "category": "Colors",
            "description": "Base background color for dark mode.",
            "options": [
                { "label": "⬛ Black (Default)", "value": "black" },
                { "label": "🔘 Charcoal", "value": "charcoal" },
                { "label": "🔵 Navy", "value": "navy" },
                { "label": "🔘 Slate", "value": "slate" },
                { "label": "🟢 Forest", "value": "forest" },
                { "label": "🔴 Wine / Burgundy", "value": "wine" },
                { "label": "🔵 Midnight", "value": "midnight" },
                { "label": "🟣 Dark Plum", "value": "plum" },
                { "label": "🟠 Dark Earth", "value": "earth" }
            ]
        },
        "bg_dark_variant": {
            "label": "Dark Background Variant",
            "type": "select",
            "default": "clean",
            "category": "Colors",
            "description": "Fine-tune the dark background tone.",
            "options": [
                { "label": "Clean (Pure)", "value": "clean" },
                { "label": "Soft", "value": "soft" },
                { "label": "Matte", "value": "matte" },
                { "label": "Deep", "value": "deep" }
            ]
        },
        "font_heading": {
            "label": "Heading Font",
            "type": "select",
            "options": [
