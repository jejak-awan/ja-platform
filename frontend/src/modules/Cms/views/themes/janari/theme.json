                {
                    "label": "Custom (Manual)",
                    "value": "custom"
                },
                {
                    "label": "Monochrome Clean",
                    "value": "monochrome_clean"
                },
                {
                    "label": "Oceanic Clean",
                    "value": "oceanic_clean"
                },
                {
                    "label": "Emerald Fresh",
                    "value": "emerald_fresh"
                },
                {
                    "label": "Royal Violet",
                    "value": "royal_violet"
                },
                {
                    "label": "Sunset Coral",
                    "value": "sunset_coral"
                },
                {
                    "label": "Midnight Cyan",
                    "value": "midnight_cyan"
                },
                {
                    "label": "Forest Earth",
                    "value": "forest_earth"
                },
                {
                    "label": "Ruby Night",
                    "value": "ruby_night"
                },
                {
                    "label": "Aurora Mint",
                    "value": "aurora_mint"
                },
                {
                    "label": "Slate Indigo",
                    "value": "slate_indigo"
                },
                {
                    "label": "Arctic Blue",
                    "value": "arctic_blue"
                },
                {
                    "label": "Sand Stone",
                    "value": "sand_stone"
                }
            ]
