            "default": "full",
            "category": "Layout",
            "description": "Choose overall page layout style"
        },
        "home_sections": {
            "label": "Active Home Sections",
            "type": "checkbox_list",
            "options": [
                {
                    "label": "Hero Section",
                    "value": "hero"
                },
                {
                    "label": "Principal Message",
                    "value": "principal"
                },
                {
                    "label": "Programs / Majors",
                    "value": "programs"
                },
                {
                    "label": "Statistics",
                    "value": "stats"
                },
                {
                    "label": "Industry Partners (Mitra DU/DI)",
                    "value": "partners"
                },
                {
                    "label": "Testimonials",
                    "value": "testimonials"
                },
                {
                    "label": "News & Highlights",
                    "value": "news"
                },
                {
                    "label": "Call to Action",
                    "value": "cta"
                }
            ],
            "default": [
                "hero",
                "principal",
                "programs",
                "stats",
                "partners",
                "testimonials",
                "news",
                "cta"
            ],
            "category": "Layout"
        },
        "container_max_width": {
            "label": "Container Max Width",
            "type": "range",
            "min": 1200,
            "max": 1920,
            "step": 40,
            "default": 1400,
            "category": "Layout",
            "description": "Max width in pixels (for Boxed/Wide/Framed)"
