# OS/editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.*
!frontend/.env.example

# Dependencies and build artifacts
backend/vendor/
backend/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
# Vite must not copy stale hashed bundles from here into dist (keep only static subtrees e.g. themes/)
frontend/public/assets/*
!frontend/public/assets/themes/
!frontend/public/assets/themes/**
ja-backup/

# Local lint / analysis dumps (not source)
frontend/eslint-current.json
frontend/lint_report_final.json
frontend/unused_vars.txt
frontend/public/stats.html
backend/phpunit.coverage.xml
backend/build/

# Runtime/cache artifacts
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore
backend/phpstan-output.txt
backend/public/assets/
